{
  "name": "web-assignment",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time messaging system - Angular + NestJS",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w @chat/shared && npm run prisma:generate -w @chat/api && npm run build -w @chat/api && npm run build -w @chat/web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "start": "NODE_ENV=production node apps/api/dist/main.js",
    "seed": "npm run seed -w @chat/api",
    "test": "npm run test -w @chat/api",
    "test:e2e": "npm run test:realtime -w @chat/api && npm run test:media -w @chat/api",
    "migrate": "npm run prisma:migrate -w @chat/api"
  },
  "overrides": {
    "vitest": "4.1.11",
    "@vitest/browser-playwright": "4.1.11"
  }
}
