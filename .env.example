# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=3000
# Public origin of the deployed app. Used for cookie + CORS decisions.
APP_ORIGIN=http://localhost:4200

# ------------------------------------------------------------ database
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat?schema=public

# --------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------- auth
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-production-000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-production-00
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --------------------------------------------- object storage (S3-compatible)
# Local dev points at MinIO from docker-compose. Production can point at any
# S3-compatible provider (Backblaze B2, Cloudflare R2, MinIO, AWS S3 itself);
# the client only speaks the S3 API, so swapping providers is an env change.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=chat-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO and Backblaze B2 both work with path-style addressing.
S3_FORCE_PATH_STYLE=true
# Public base URL for serving stored objects.
S3_PUBLIC_URL=http://localhost:9000/chat-media

# ----------------------------------------------------------- moderation
# Reject an image when any of these is exceeded. See README for rationale.
NSFW_THRESHOLD_PORN=0.60
NSFW_THRESHOLD_HENTAI=0.60
NSFW_THRESHOLD_SEXY=0.85
NSFW_THRESHOLD_COMBINED=0.75

# ------------------------------------------------------------------ gif
# Tenor's public API was shut down on 2026-06-30. Klipy publishes a
# Tenor-compatible v2/search+v2/featured proxy, so this is a drop-in.
# Get a key from the Partner Panel: https://docs.klipy.com/getting-started
KLIPY_API_KEY=
